{
  "type": "module",
  "name": "offline-fitness",
  "version": "1.3.0",
  "scripts": {
    "start": "expo start --dev-client",
    "tool:seed": "tsx scripts/strava-import-tool/cli.ts",
    "start2": "npx expo start --no-dev --minify",
    "start:chrome": "set BROWSER=\"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\" && expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "bckgnd": "adb shell dumpsys jobscheduler | grep -A 40 -m 1 -E JOB #.*bruno",
    "version:increment": "node increment-version.cjs",
    "install:apk": "adb devices | grep -q 'device$' && adb install -r ./android/app/build/outputs/apk/release/app-release.apk || echo 'No Android devices connected. Please connect a device and try again.'",
    "build:local": "npm run version:increment && npx expo prebuild --platform android --no-clean && cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a && cd .. && npm run install:apk",
    "build:local:clean": "npm run version:increment && npx expo prebuild --platform android && cd android && ./gradlew clean assembleRelease -PreactNativeArchitectures=arm64-v8a && cd .. && npm run install:apk",
    "w:build:local": "npm run version:increment && npx expo prebuild --platform android --no-clean && cd android && .\\gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a && cd .. && npm run install:apk",
    "w:build:local:clean": "npm run version:increment && npx expo prebuild --platform android && cd android && .\\gradlew clean assembleRelease -PreactNativeArchitectures=arm64-v8a && cd .. && npm run install:apk",
    "publish:apk": "node publish-apk.cjs",
    "android:dev:prebuild": "npx expo prebuild --platform android --no-install",
    "android:dev:install": "cd android && ./gradlew installDebug",
    "android:dev:uninstall": "adb shell pm clear $(node scripts/android-package.cjs) || true && adb shell pm uninstall $(node scripts/android-package.cjs) || true",
    "android:metro:clear": "rm -rf node_modules/.cache/metro .expo || true",
    "start:metro:8081": "npx expo start --dev-client --reset-cache --clear --port 8081",
    "android:dev": "npm run android:dev:prebuild && npm run android:dev:install && npm run start:metro:8081",
    "android:dev:reinstall": "npm run android:dev:uninstall && npm run android:dev",
    "pretty": "npx prettier --write '**/*.{ts,tsx,js,jsx}'",
    "check:imports": "node scripts/check-imports.cjs",
    "check:install-scripts": "node scripts/check-install-scripts.cjs",
    "check:mobile-only": "node scripts/check-mobile-only.cjs",
    "adb:reverse": "adb -s emulator-5554 reverse tcp:8081 tcp:8081"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native/assets-registry": "^0.72.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/drawer": "^7.5.8",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@rivascva/react-native-code-editor": "^1.2.2",
    "@shopify/flash-list": "2.0.2",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "expo": "~57.0.31",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.14",
    "expo-build-properties": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-location": "~57.0.22",
    "expo-navigation-bar": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expr-eval": "^2.0.2",
    "jszip": "^3.10.1",
    "pako": "^1.0.11",
    "papaparse": "^5.4.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-reanimated-table": "^0.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "simplify-js": "^1.2.4",
    "victory-native": "^36.6.11"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@react-native-community/cli": "latest",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^12.9.0",
    "@tsconfig/react-native": "^2.0.3",
    "@types/jest": "^29.5.14",
    "@types/papaparse": "^5.3.14",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.10.12",
    "eslint": "^9.33.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-flat-config-utils": "^2.1.1",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-regexp": "^3.3.1",
    "expo-dev-client": "~57.0.20",
    "geo-tz": "8.1.10",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.6.2",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.39.1"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "__tests__/helpers/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|expo-file-system|victory-.*|react-syntax-highlighter|@rivascva/react-native-code-editor|@react-native-clipboard)"
    ],
    "moduleNameMapper": {
      "@react-native-clipboard/clipboard": "<rootDir>/__mocks__/@react-native-clipboard/clipboard.js"
    },
    "setupFiles": [
      "./jest.setup.js"
    ]
  },
  "overrides": {
    "@tootallnate/once": ">=3.0.1",
    "prismjs": "1.30.0",
    "react-native-safe-area-context": "~5.7.0"
  },
  "description": "Offline-first personal activity analytics — import your Strava data archive and browse maps, stats and streaks without any account or API access.",
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "unrs-resolver": false
  }
}
