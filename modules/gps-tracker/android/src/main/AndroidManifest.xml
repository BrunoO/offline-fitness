<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Recording needs a location-typed foreground service. The app owns the runtime
       permission (expo-location); this module never asks for it (D5 in docs/recording-plan.md).
       REQUEST_IGNORE_BATTERY_OPTIMIZATIONS is deliberately absent: it belongs to the
       post-MVP battery-exemption banner (D9), not the recorder itself. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.VIBRATE" />

  <application>
    <service
      android:name="com.gpslib.tracker.service.TrackingService"
      android:exported="false"
      android:foregroundServiceType="location" />
  </application>
</manifest>
