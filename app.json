{
  "expo": {
    "experiments": {
      "reactCompiler": true
    },
    "name": "Offline Fitness",
    "slug": "offline-fitness",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*",
      "assets/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.offlinefitness"
    },
    "android": {
      "versionCode": 0,
      "config": {
        "googleMaps": {
          "apiKey": "SET_VIA_EXPO_PUBLIC_GOOGLE_MAPS_API_KEY"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.example.offlinefitness"
    },
    "platforms": ["ios", "android"],
    "scheme": "offlinefitness",
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "enableFullScreenImage_legacy": "false",
          "backgroundColor": "#F3EEFF",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#241E3A"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ]
  }
}